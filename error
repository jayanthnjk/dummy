// ===== Leave Management Panel (Two-card layout matching Duty Management) =====
interface LeaveManagementPanelProps {
  sectionCode: string;
  sectionColor: string;
  sectionBgColor: string;
  chartData: SectionChartData;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  onAssign?: any;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  onUnassign?: any;
  onRefresh?: () => void;
  selectedCategory: string;
  onCategoryChange: (category: string) => void;
  highlightedPersonId?: number | null;
}

const LeaveManagementPanel: React.FC<LeaveManagementPanelProps> = ({
  sectionCode, sectionColor, sectionBgColor,
  selectedCategory, onCategoryChange, chartData, highlightedPersonId,
}) => {
  const { t } = useTranslation();
  const [leaveRecords, setLeaveRecords] = useState<LeaveRequestDto[]>([]);
  const [loading, setLoading] = useState(false);
  const [addDialogOpen, setAddDialogOpen] = useState(false);

  // Dynamic leave types from API
  const [leaveTypesFromApi, setLeaveTypesFromApi] = useState<LeaveTypeFromApi[]>([]);

  // Fetch leave types from API on mount
  useEffect(() => {
    api.get<LeaveTypeFromApi[]>('/api/leave-types')
      .then((res) => setLeaveTypesFromApi(res.data))
      .catch(() => { /* fallback to defaults */ });
  }, []);

  // Build LEAVE_CATEGORIES from API data (or fallback to defaults)
  const LEAVE_CATEGORIES = useMemo(() => {
    if (leaveTypesFromApi.length > 0) {
      return leaveTypesFromApi.map((lt) => ({
        id: lt.id,
        name: lt.displayName,
        code: lt.code,
        nameKey: '',
        descKey: '',
      }));
    }
    return DEFAULT_LEAVE_CATEGORIES.map((c, idx) => ({ ...c, id: idx, code: '' }));
  }, [leaveTypesFromApi]);

  // Build dynamic maps from API data
  const LEAVE_TYPE_MAP_DYNAMIC = useMemo(() => {
    const map: Record<string, string> = {};
    leaveTypesFromApi.forEach((lt) => { map[lt.displayName] = lt.code; });
    return map;
  }, [leaveTypesFromApi]);

  const BACKEND_TO_DISPLAY_DYNAMIC = useMemo(() => {
    const map: Record<string, string> = {};
    leaveTypesFromApi.forEach((lt) => { map[lt.code] = lt.displayName; });
    return map;
  }, [leaveTypesFromApi]);
  const [saving, setSaving] = useState(false);
  const [formData, setFormData] = useState<{
    personnelId: number | null;
    personnelName: string;
    startDate: string;
    endDate: string;
    reason: string;
  }>({ personnelId: null, personnelName: '', startDate: '', endDate: '', reason: '' });

  // Close Leave state
  const [closeLeaveRecord, setCloseLeaveRecord] = useState<LeaveRequestDto | null>(null);
  const [closeLeaveEndDate, setCloseLeaveEndDate] = useState('');
  const [closeLeaveComments, setCloseLeaveComments] = useState('');

  // Add Leave Type state
  const [showAddLeaveType, setShowAddLeaveType] = useState(false);
  const [newLeaveTypeName, setNewLeaveTypeName] = useState('');
  const [addingLeaveType, setAddingLeaveType] = useState(false);

  // Build set of personnel IDs belonging to this section from chartData
  const sectionPersonnelIds = useMemo(() => {
    const ids = new Set<number>();
    if (chartData) {
      for (const card of chartData.dutyCards) {
        for (const p of card.personnel) { ids.add(p.id); }
        for (const sub of card.subDuties) {
          for (const p of sub.personnel) { ids.add(p.id); }
        }
      }
    }
    return ids;
  }, [chartData]);

  // Fetch active leave records on mount and filter by section
  const fetchLeaveRecords = useCallback(async () => {
    setLoading(true);
    try {
      const result = await leaveService.list(undefined, 0, 500);
      const today = new Date().toISOString().split('T')[0];
      
      // Filter for APPROVED leaves where today is between startDate and endDate (or endDate is null/undefined = ongoing)
      const activeLeaves = result.content.filter((lr) => {
        const isApproved = lr.status === 'APPROVED';
        const startOk = lr.startDate <= today;
        // Handle both null and undefined for open-ended leaves
        const endOk = !lr.endDate || lr.endDate >= today;
        return isApproved && startOk && endOk;
      });
      // Filter by section personnel IDs (if available)
      const sectionLeaves = sectionPersonnelIds.size > 0
        ? activeLeaves.filter((lr) => sectionPersonnelIds.has(lr.personnelId))
        : activeLeaves;
      
      setLeaveRecords(sectionLeaves);
    } catch {
      // Error fetching leave records
    } finally {
      setLoading(false);
    }
  }, [sectionPersonnelIds]);

  useEffect(() => {
    fetchLeaveRecords();
  }, [fetchLeaveRecords]);

  // Group leave records by display category
  const leaveGroups: Record<string, LeaveRequestDto[]> = {};
  LEAVE_CATEGORIES.forEach((cat) => { leaveGroups[cat.name] = []; });

  leaveRecords.forEach((lr) => {
    const displayName = BACKEND_TO_DISPLAY_DYNAMIC[lr.leaveType] || BACKEND_TO_DISPLAY[lr.leaveType] || lr.leaveType;
    if (leaveGroups[displayName]) {
      leaveGroups[displayName].push(lr);
    } else {
      // Fallback: put in first category
      leaveGroups[LEAVE_CATEGORIES[0]?.name]?.push(lr);
    }
  });

  const totalLeavePersonnel = leaveRecords.length;
  const selectedCategoryData = LEAVE_CATEGORIES.find((c) => c.name === selectedCategory);
  const selectedRecords = leaveGroups[selectedCategory] || [];

  // Handle adding a new leave type
  const handleAddLeaveType = async () => {
    if (!newLeaveTypeName.trim()) return;
    setAddingLeaveType(true);
    try {
      const normalizedCode = newLeaveTypeName.trim().toUpperCase().replace(/\s+/g, '_');
      await api.post('/api/leave-types', {
        code: normalizedCode,
        displayName: newLeaveTypeName.trim().toUpperCase(),
      });
      setNewLeaveTypeName('');
      setShowAddLeaveType(false);
      // Refresh leave types from API
      const res = await api.get<LeaveTypeFromApi[]>('/api/leave-types');
      setLeaveTypesFromApi(res.data);
    } catch {
      // Error adding leave type
    } finally {
      setAddingLeaveType(false);
    }
  };

  // Handle adding a leave record
  const handleSubmitLeave = async () => {
    // Allow all leave types to be submitted without end date (open-ended)
    if (!formData.personnelId || !formData.startDate) return;
    setSaving(true);
    try {
      const backendLeaveType = LEAVE_TYPE_MAP_DYNAMIC[selectedCategory] || LEAVE_TYPE_MAP[selectedCategory] || 'CASUAL_LEAVE';
      await leaveService.submit({
        personnelId: formData.personnelId,
        leaveType: backendLeaveType,
        startDate: formData.startDate,
        endDate: formData.endDate || undefined,
        reason: formData.reason || undefined,
      });
      setAddDialogOpen(false);
      setFormData({ personnelId: null, personnelName: '', startDate: '', endDate: '', reason: '' });
      fetchLeaveRecords();
    } catch {
      // Error submitting leave
    } finally {
      setSaving(false);
    }
  };

  // Handle closing an open-ended leave
  const handleCloseLeaveConfirm = async () => {
    if (!closeLeaveRecord || !closeLeaveEndDate) return;
    setSaving(true);
    try {
      await leaveService.close(closeLeaveRecord.id, closeLeaveEndDate, closeLeaveComments);
      setCloseLeaveRecord(null);
      setCloseLeaveEndDate('');
      setCloseLeaveComments('');
      fetchLeaveRecords();
    } catch {
      // Error closing leave
    } finally {
      setSaving(false);
    }
  };

  // Handle canceling a leave
  const handleCancelLeave = async (id: number) => {
    setSaving(true);
    try {
      await leaveService.cancel(id);
      fetchLeaveRecords();
    } catch {
      // Error canceling leave
    } finally {
      setSaving(false);
    }
  };

  // Calculate days between two dates
  const calculateDays = (start: string, end: string | null): number | string => {
    if (!end) {
      // Open-ended (sick leave) — calculate from start to today
      const startMs = new Date(start).getTime();
      const todayMs = new Date().getTime();
      return Math.floor((todayMs - startMs) / (1000 * 60 * 60 * 24)) + 1;
    }
    const startMs = new Date(start).getTime();
    const endMs = new Date(end).getTime();
    return Math.floor((endMs - startMs) / (1000 * 60 * 60 * 24)) + 1;
  };

  return (
    <Box sx={{ display: 'flex', gap: 2, alignItems: 'flex-start' }}>
      {/* LEFT SIDEBAR: Leave Categories */}
      <Paper
        elevation={0}
        sx={{
          width: { xs: 200, sm: 240, md: 280 },
          flexShrink: 0,
          border: '1px solid',
          borderColor: 'divider',
          borderRadius: '12px',
          display: 'flex',
          flexDirection: 'column',
          position: 'sticky',
          top: 16,
        }}
      >
        {/* Sidebar Header */}
        <Box sx={{ px: 2, py: 1.5, bgcolor: sectionBgColor, borderBottom: '1px solid', borderColor: 'divider' }}>
          <Typography variant="subtitle2" sx={{ fontWeight: 700, color: sectionColor }}>
            {t('assignDuties.leavePanel.title')}
          </Typography>
          <Typography variant="caption" color="text.secondary">
            {LEAVE_CATEGORIES.length} {t('assignDuties.leavePanel.types')} • {totalLeavePersonnel} {t('assignDuties.dutyPanel.personnel')}
          </Typography>
        </Box>

        {/* Leave Category List */}
        <Box>
          <List dense disablePadding>
            {LEAVE_CATEGORIES.map((cat) => {
              const count = leaveGroups[cat.name]?.length || 0;
              return (
                <ListItemButton
                  key={cat.name}
                  selected={selectedCategory === cat.name}
                  onClick={() => onCategoryChange(cat.name)}
                  sx={{
                    px: 2, py: 1,
                    borderLeft: selectedCategory === cat.name ? `3px solid ${sectionColor}` : '3px solid transparent',
                    '&.Mui-selected': { bgcolor: `${sectionColor}08` },
                    '&.Mui-selected:hover': { bgcolor: `${sectionColor}12` },
                  }}
                >
                  <ListItemText
                    primary={
                      <Stack direction="row" spacing={0.5} alignItems="center">
                        <Typography
                          variant="caption"
                          sx={{
                            fontWeight: selectedCategory === cat.name ? 700 : 500,
                            fontSize: '0.7rem',
                            textTransform: 'uppercase',
                            letterSpacing: '0.3px',
                            overflow: 'hidden',
                            textOverflow: 'ellipsis',
                            whiteSpace: 'nowrap',
                            flex: 1,
                          }}
                        >
                          {cat.nameKey ? t(cat.nameKey) : cat.name}
                        </Typography>
                        <Chip
                          label={count}
                          size="small"
                          sx={{
                            height: 18, fontSize: '0.6rem', fontWeight: 700,
                            bgcolor: count > 0 ? `${sectionColor}15` : 'grey.100',
                            color: count > 0 ? sectionColor : 'text.disabled',
                          }}
                        />
                        {'id' in cat && cat.id && count === 0 && (
                          <IconButton
                            size="small"
                            onClick={(e) => {
                              e.stopPropagation();
                              api.delete(`/api/leave-types/${cat.id}`)
                                .then(() => api.get<LeaveTypeFromApi[]>('/api/leave-types'))
                                .then((res) => setLeaveTypesFromApi(res.data));
                            }}
                            sx={{ p: 0.25, color: '#dc2626', opacity: 0.6, '&:hover': { opacity: 1 } }}
                          >
                            <DeleteOutlineIcon sx={{ fontSize: 14 }} />
                          </IconButton>
                        )}
                        {'id' in cat && cat.id && (
                          <IconButton
                            size="small"
                            onClick={(e) => {
                              e.stopPropagation();
                              const newName = prompt('Rename leave type:', cat.name);
                              if (newName && newName.trim() && newName.trim() !== cat.name) {
                                api.put(`/api/leave-types/${cat.id}`, { displayName: newName.trim() })
                                  .then(() => api.get<LeaveTypeFromApi[]>('/api/leave-types'))
                                  .then((res) => setLeaveTypesFromApi(res.data));
                              }
                            }}
                            sx={{ p: 0.25, color: '#2563eb', opacity: 0.6, '&:hover': { opacity: 1 } }}
                          >
                            <EditIcon sx={{ fontSize: 14 }} />
                          </IconButton>
                        )}
                      </Stack>
                    }
                  />
                </ListItemButton>
              );
            })}
          </List>
        </Box>

        {/* Add Leave Type */}
        <Box sx={{ px: 2, py: 1, borderTop: '1px solid', borderColor: 'divider' }}>
          {showAddLeaveType ? (
            <Stack spacing={1}>
              <TextField
                size="small"
                placeholder={t('assignDuties.leavePanel.leaveTypeName')}
                value={newLeaveTypeName}
                onChange={(e) => setNewLeaveTypeName(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === 'Enter' && newLeaveTypeName.trim()) {
                    handleAddLeaveType();
                  } else if (e.key === 'Escape') {
                    setShowAddLeaveType(false);
                    setNewLeaveTypeName('');
                  }
                }}
                autoFocus
                fullWidth
                sx={{ '& .MuiInputBase-input': { fontSize: '0.75rem' } }}
              />
              <Stack direction="row" spacing={0.5}>
                <Button
                  size="small"
                  variant="contained"
                  disabled={!newLeaveTypeName.trim() || addingLeaveType}
                  onClick={handleAddLeaveType}
                  sx={{ fontSize: '0.65rem', textTransform: 'none', flex: 1 }}
                >
                  {addingLeaveType ? t('assignDuties.leavePanel.adding') : t('app.add')}
                </Button>
                <Button
                  size="small"
                  onClick={() => { setShowAddLeaveType(false); setNewLeaveTypeName(''); }}
                  sx={{ fontSize: '0.65rem', textTransform: 'none' }}
                >
                  {t('app.cancel')}
                </Button>
              </Stack>
            </Stack>
          ) : (
            <Button
              size="small"
              startIcon={<AddCircleOutlineIcon sx={{ fontSize: 14 }} />}
              onClick={() => setShowAddLeaveType(true)}
              sx={{ fontSize: '0.7rem', textTransform: 'none', color: sectionColor }}
            >
              {t('assignDuties.leavePanel.addLeaveType')}
            </Button>
          )}
        </Box>
      </Paper>

      {/* RIGHT: Detail Panel for selected leave category */}
      <Box sx={{ flex: 1, minWidth: 0, alignSelf: 'stretch' }}>
        {selectedCategoryData ? (
          <Paper
            elevation={0}
            sx={{ border: '1px solid', borderColor: 'divider', borderRadius: '12px', height: '100%', display: 'flex', flexDirection: 'column' }}
          >
            {/* Header */}
            <Box sx={{ px: 3, py: 2, bgcolor: sectionBgColor, borderBottom: '1px solid', borderColor: 'divider' }}>
              <Stack direction="row" spacing={1.5} alignItems="center" justifyContent="space-between">
                <Stack direction="row" spacing={1.5} alignItems="center">
                  <Typography variant="h6" sx={{ fontWeight: 700, color: sectionColor, textTransform: 'uppercase', letterSpacing: '0.5px' }}>
                    {t(selectedCategoryData.nameKey)}
                  </Typography>
                  <Chip
                    label={`${selectedRecords.length} ${t('assignDuties.dutyPanel.personnel')}`}
                    size="small"
                    sx={{ fontWeight: 600, bgcolor: `${sectionColor}15`, color: sectionColor }}
                  />
                </Stack>
                <Button
                  size="small"
                  variant="contained"
                  startIcon={<PersonAddIcon sx={{ fontSize: 16 }} />}
                  onClick={() => setAddDialogOpen(true)}
                  sx={{ textTransform: 'none' }}
                >
                  {t('assignDuties.leavePanel.addPersonOnLeave')}
                </Button>
              </Stack>
              <Typography variant="caption" color="text.secondary">
                {t(selectedCategoryData.descKey)}
              </Typography>
            </Box>

            {/* Leave Records Table */}
            <Box sx={{ flex: 1, overflowY: 'auto', p: 2 }}>
              {loading ? (
                <Box sx={{ display: 'flex', justifyContent: 'center', py: 4 }}>
                  <CircularProgress size={24} />
                </Box>
              ) : selectedRecords.length > 0 ? (
                <Box sx={{ overflowX: 'auto' }}>
                  <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.82rem' }}>
                    <thead>
                      <tr style={{ borderBottom: '2px solid #e0e0e0' }}>
                        <th style={{ textAlign: 'left', padding: '8px 12px', fontWeight: 700, fontSize: '0.75rem', textTransform: 'uppercase', color: '#666' }}>{t('assignDuties.leavePanel.tableHeaders.badgeId')}</th>
                        <th style={{ textAlign: 'left', padding: '8px 12px', fontWeight: 700, fontSize: '0.75rem', textTransform: 'uppercase', color: '#666' }}>{t('assignDuties.leavePanel.tableHeaders.name')}</th>
                        <th style={{ textAlign: 'left', padding: '8px 12px', fontWeight: 700, fontSize: '0.75rem', textTransform: 'uppercase', color: '#666' }}>{t('assignDuties.leavePanel.tableHeaders.startDate')}</th>
                        <th style={{ textAlign: 'left', padding: '8px 12px', fontWeight: 700, fontSize: '0.75rem', textTransform: 'uppercase', color: '#666' }}>{t('assignDuties.leavePanel.tableHeaders.endDate')}</th>
                        <th style={{ textAlign: 'center', padding: '8px 12px', fontWeight: 700, fontSize: '0.75rem', textTransform: 'uppercase', color: '#666' }}>{t('assignDuties.leavePanel.tableHeaders.days')}</th>
                        <th style={{ textAlign: 'left', padding: '8px 12px', fontWeight: 700, fontSize: '0.75rem', textTransform: 'uppercase', color: '#666' }}>{t('assignDuties.leavePanel.tableHeaders.reason')}</th>
                        <th style={{ textAlign: 'center', padding: '8px 12px', fontWeight: 700, fontSize: '0.75rem', textTransform: 'uppercase', color: '#666' }}>{t('assignDuties.leavePanel.tableHeaders.actions')}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {selectedRecords.map((record) => {
                        const isHighlighted = highlightedPersonId === record.personnelId;
                        return (
                        <tr 
                          key={record.id} 
                          style={{ 
                            borderBottom: '1px solid #f0f0f0',
                            backgroundColor: isHighlighted ? '#fef9c3' : undefined,
                            boxShadow: isHighlighted ? '0 0 12px rgba(234, 179, 8, 0.4)' : undefined,
                          }}
                          className={isHighlighted ? 'highlight-pulse' : undefined}
                        >
                          <td style={{ padding: '8px 12px', fontWeight: 600, color: '#1976d2' }}>{record.badgeId || '—'}</td>
                          <td style={{ padding: '8px 12px' }}>{record.personnelName}</td>
                          <td style={{ padding: '8px 12px' }}>{record.startDate}</td>
                          <td style={{ padding: '8px 12px' }}>{record.endDate || t('assignDuties.leavePanel.ongoing')}</td>
                          <td style={{ padding: '8px 12px', textAlign: 'center', fontWeight: 600 }}>{calculateDays(record.startDate, record.endDate)}</td>
                          <td style={{ padding: '8px 12px', maxWidth: 200, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{record.reason || '—'}</td>
                          <td style={{ padding: '8px 12px', textAlign: 'center' }}>
                            <Box sx={{ display: 'inline-flex', gap: 0.5 }}>
                              {/* Close Leave button - only for leaves without end date */}
                              {!record.endDate && (
                                <Tooltip title={t('assignDuties.leavePanel.closeLeave')}>
                                  <IconButton
                                    size="small"
                                    onClick={() => { setCloseLeaveRecord(record); setCloseLeaveEndDate(''); setCloseLeaveComments(''); }}
                                    disabled={saving}
                                    sx={{ color: '#1d4ed8' }}
                                  >
                                    <EventAvailableIcon sx={{ fontSize: 16 }} />
                                  </IconButton>
                                </Tooltip>
                              )}
                              <Tooltip title={t('assignDuties.leavePanel.cancelLeave')}>
                                <IconButton
                                  size="small"
                                  onClick={() => handleCancelLeave(record.id)}
                                  disabled={saving}
                                  sx={{ color: 'error.main' }}
                                >
                                  <DeleteOutlineIcon sx={{ fontSize: 16 }} />
                                </IconButton>
                              </Tooltip>
                            </Box>
                          </td>
                        </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </Box>
              ) : (
                <Typography variant="body2" color="text.secondary" sx={{ py: 2 }}>
                  {t('assignDuties.leavePanel.noActiveRecords')}
                </Typography>
              )}
            </Box>
          </Paper>
        ) : (
          <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'center', height: '100%', opacity: 0.5 }}>
            <Typography variant="body2" color="text.secondary">
              {t('assignDuties.leavePanel.selectLeaveType')}
            </Typography>
          </Box>
        )}
      </Box>

      {/* Add Leave Dialog */}
      <Dialog open={addDialogOpen} onClose={() => setAddDialogOpen(false)} maxWidth="sm" fullWidth>
        <DialogTitle>{t('assignDuties.leavePanel.addPersonOnLeave')} — {t(LEAVE_CATEGORIES.find(c => c.name === selectedCategory)?.nameKey || '')}</DialogTitle>
        <DialogContent>
          <Stack spacing={2.5} sx={{ mt: 1 }}>
            <Box>
              <Typography variant="caption" color="text.secondary" sx={{ mb: 0.5, display: 'block' }}>
                {t('app.person')}
              </Typography>
              {formData.personnelId ? (
                <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, p: 1.5, bgcolor: '#f0fdf4', borderRadius: 2, border: '1px solid #bbf7d0' }}>
                  <Box sx={{ flex: 1 }}>
                    <Typography sx={{ fontSize: '0.85rem', fontWeight: 600, color: '#166534' }}>
                      {formData.personnelName || `Person ID: ${formData.personnelId}`}
                    </Typography>
                  </Box>
                  <Button size="small" onClick={() => setFormData((prev) => ({ ...prev, personnelId: null, personnelName: '' }))}
                    sx={{ textTransform: 'none', fontSize: '0.75rem', color: '#dc2626' }}>
                    Change
                  </Button>
                </Box>
              ) : (
                <PersonnelAutocomplete
                  onSelect={(personnelId) => setFormData((prev) => ({ ...prev, personnelId }))}
                  onSelectWithDetails={(personnelId, personName, badgeId) => setFormData((prev) => ({ ...prev, personnelId, personnelName: `${personName} (${badgeId})` }))}
                  onCancel={() => setFormData((prev) => ({ ...prev, personnelId: null, personnelName: '' }))}
                />
              )}
            </Box>
            <TextField
              label={t('leave.startDate')}
              type="date"
              size="small"
              fullWidth
              InputLabelProps={{ shrink: true }}
              value={formData.startDate}
              onChange={(e) => setFormData((prev) => ({ ...prev, startDate: e.target.value }))}
            />
            <TextField
              label={t('leave.endDate')}
              type="date"
              size="small"
              fullWidth
              InputLabelProps={{ shrink: true }}
              value={formData.endDate}
              onChange={(e) => setFormData((prev) => ({ ...prev, endDate: e.target.value }))}
              helperText={t('assignDuties.leavePanel.leaveBlankForOpenEnded')}
            />
            <TextField
              label={t('leave.reason')}
              size="small"
              fullWidth
              multiline
              rows={2}
              value={formData.reason}
              onChange={(e) => setFormData((prev) => ({ ...prev, reason: e.target.value }))}
            />
          </Stack>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => { setAddDialogOpen(false); setFormData({ personnelId: null, personnelName: '', startDate: '', endDate: '', reason: '' }); }}>
            {t('app.cancel')}
          </Button>
          <Button
            variant="contained"
            onClick={handleSubmitLeave}
            disabled={saving || !formData.personnelId || !formData.startDate}
          >
            {saving ? <CircularProgress size={18} /> : t('app.submit')}
          </Button>
        </DialogActions>
      </Dialog>

      {/* Close Leave Dialog */}
      <Dialog open={closeLeaveRecord !== null} onClose={() => setCloseLeaveRecord(null)} maxWidth="xs" fullWidth>
        <DialogTitle sx={{ color: '#1d4ed8' }}>{t('assignDuties.closeLeaveDialog.title')}</DialogTitle>
        <DialogContent>
          {closeLeaveRecord && (
            <Stack spacing={2} sx={{ mt: 1 }}>
              <Box sx={{ bgcolor: '#f9fafb', borderRadius: 1, p: 1.5, border: '1px solid #e5e7eb' }}>
                <Typography variant="caption" color="text.secondary">{t('assignDuties.closeLeaveDialog.personnel')}</Typography>
                <Typography variant="body2" fontWeight={600}>{closeLeaveRecord.personnelName}</Typography>
                <Typography variant="caption" color="text.secondary" sx={{ mt: 1, display: 'block' }}>{t('assignDuties.closeLeaveDialog.leaveType')}</Typography>
                <Typography variant="body2">{closeLeaveRecord.leaveType.replace(/_/g, ' ')}</Typography>
                <Typography variant="caption" color="text.secondary" sx={{ mt: 1, display: 'block' }}>{t('assignDuties.closeLeaveDialog.startDate')}</Typography>
                <Typography variant="body2">{closeLeaveRecord.startDate}</Typography>
              </Box>
              <TextField
                label={t('assignDuties.closeLeaveDialog.endDate')}
                type="date"
                size="small"
                fullWidth
                required
                InputLabelProps={{ shrink: true }}
                inputProps={{ min: closeLeaveRecord.startDate }}
                value={closeLeaveEndDate}
                onChange={(e) => setCloseLeaveEndDate(e.target.value)}
              />
              <TextField
                label={t('assignDuties.closeLeaveDialog.comments')}
                size="small"
                fullWidth
                multiline
                rows={2}
                value={closeLeaveComments}
                onChange={(e) => setCloseLeaveComments(e.target.value)}
                placeholder={t('assignDuties.closeLeaveDialog.commentsPlaceholder')}
              />
            </Stack>
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setCloseLeaveRecord(null)}>{t('app.cancel')}</Button>
          <Button
            variant="contained"
            onClick={handleCloseLeaveConfirm}
            disabled={saving || !closeLeaveEndDate}
            sx={{ bgcolor: '#1d4ed8', '&:hover': { bgcolor: '#1e40af' } }}
          >
            {saving ? <CircularProgress size={18} /> : t('assignDuties.closeLeaveDialog.closeLeave')}
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default AssignDutiesPage;
