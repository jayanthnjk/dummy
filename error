// ===== Personnel Autocomplete =====
interface PersonnelAutocompleteProps {
  onSelect: (personnelId: number) => void;
  onSelectWithDetails?: (personnelId: number, personName: string, badgeId: string) => void;
  onCancel: () => void;
}

const PersonnelAutocomplete: React.FC<PersonnelAutocompleteProps> = ({ onSelect, onSelectWithDetails, onCancel }) => {
  const { t } = useTranslation();
  const [options, setOptions] = useState<PersonnelSearchResult[]>([]);
  const [inputValue, setInputValue] = useState('');
  const [loading, setLoading] = useState(false);
  const [isOpen, setIsOpen] = useState(true);
  const [focusedIndex, setFocusedIndex] = useState(-1);
  const inputRef = useRef<HTMLInputElement>(null);
  const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  const searchPersonnel = useCallback(async (query: string) => {
    if (query.length < 2) {
      setOptions([]);
      return;
    }
    setLoading(true);
    try {
      const results = await sectionChartService.searchPersonnel(query, 10);
      setOptions(results);
    } catch {
      setOptions([]);
    } finally {
      setLoading(false);
    }
  }, []);

  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const value = e.target.value;
    setInputValue(value);
    setIsOpen(true);
    setFocusedIndex(-1);
    if (debounceRef.current) clearTimeout(debounceRef.current);
    debounceRef.current = setTimeout(() => searchPersonnel(value), 250);
  };

  const handleSelect = (person: PersonnelSearchResult) => {
    onSelect(person.id);
    if (onSelectWithDetails) {
      onSelectWithDetails(person.id, person.personName, person.badgeId);
    }
    setInputValue('');
    setOptions([]);
    setIsOpen(false);
  };

  const handleKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === 'Escape') {
      onCancel();
      return;
    }
    if (!isOpen || options.length === 0) return;

    switch (e.key) {
      case 'ArrowDown':
        e.preventDefault();
        setFocusedIndex(prev => (prev < options.length - 1 ? prev + 1 : 0));
        break;
      case 'ArrowUp':
        e.preventDefault();
        setFocusedIndex(prev => (prev > 0 ? prev - 1 : options.length - 1));
        break;
      case 'Enter':
        e.preventDefault();
        if (focusedIndex >= 0 && focusedIndex < options.length) {
          handleSelect(options[focusedIndex]);
        }
        break;
    }
  };

  useEffect(() => {
    inputRef.current?.focus();
  }, []);

  const hasResults = options.length > 0;
  const showDropdown = isOpen && inputValue.length >= 1;

  return (
    <Box sx={{ position: 'relative', width: '100%' }}>
      <Paper
        elevation={showDropdown && (loading || hasResults || inputValue.length >= 2) ? 2 : 0}
        sx={{
          borderRadius: showDropdown && (loading || hasResults || inputValue.length >= 2) ? '16px 16px 0 0' : '16px',
          border: '1px solid #e2e8f0',
          overflow: 'hidden',
          transition: 'all 0.15s',
        }}
      >
        {/* Search Input */}
        <Box
          sx={{
            display: 'flex',
            alignItems: 'center',
            px: 1.5,
            py: 0.75,
            bgcolor: '#fff',
          }}
        >
          <SearchIcon sx={{ color: '#9ca3af', fontSize: 18, mr: 1 }} />
          <input
            ref={inputRef}
            value={inputValue}
            onChange={handleInputChange}
            onKeyDown={handleKeyDown}
            placeholder={t('assignDuties.personnel.searchPlaceholder')}
            style={{
              flex: 1,
              border: 'none',
              outline: 'none',
              fontSize: '0.85rem',
              background: 'transparent',
            }}
          />
          {loading && <CircularProgress size={16} sx={{ color: '#9ca3af', mr: 0.5 }} />}
          <Box
            onClick={onCancel}
            sx={{
              cursor: 'pointer',
              px: 0.75,
              py: 0.25,
              borderRadius: 1,
              fontSize: '0.75rem',
              color: '#6b7280',
              '&:hover': { bgcolor: '#f1f5f9', color: '#374151' },
            }}
          >
            ✕
          </Box>
        </Box>
      </Paper>

      {/* Results Dropdown - Absolutely positioned to overlay content */}
      {showDropdown && (inputValue.length >= 2 || loading) && (
        <Paper
          elevation={4}
          sx={{
            position: 'absolute',
            top: '100%',
            left: 0,
            right: 0,
            zIndex: 1300,
            bgcolor: '#fff',
            maxHeight: 220,
            overflowY: 'auto',
            borderRadius: '0 0 16px 16px',
            boxShadow: '0 4px 20px rgba(0,0,0,0.15)',
          }}
        >
          {inputValue.length < 2 ? (
            <Box sx={{ py: 1.5, px: 2 }}>
              <Typography sx={{ fontSize: '0.8rem', color: '#9ca3af' }}>
                {t('assignDuties.personnel.typeAtLeast')}
              </Typography>
            </Box>
          ) : loading ? (
            <Box sx={{ py: 2, display: 'flex', justifyContent: 'center' }}>
              <CircularProgress size={20} />
            </Box>
          ) : hasResults ? (
            <Box sx={{ py: 0.5 }}>
              {options.map((person, index) => (
                <Box
                  key={person.id}
                  onClick={() => handleSelect(person)}
                  sx={{
                    display: 'flex',
                    alignItems: 'center',
                    px: 1.5,
                    py: 1,
                    cursor: 'pointer',
                    bgcolor: focusedIndex === index ? '#f1f5f9' : 'transparent',
                    '&:hover': { bgcolor: '#f1f5f9' },
                  }}
                >
                  <Box
                    sx={{
                      width: 24,
                      height: 24,
                      borderRadius: '50%',
                      bgcolor: '#ede9fe',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      mr: 1.5,
                      flexShrink: 0,
                    }}
                  >
                    <BadgeIcon sx={{ fontSize: 14, color: '#7c3aed' }} />
                  </Box>
                  <Box sx={{ flex: 1, minWidth: 0 }}>
                    <Typography sx={{ fontSize: '0.82rem', fontWeight: 500, color: '#1e293b' }}>
                      {person.personName}
                    </Typography>
                    <Typography sx={{ fontSize: '0.7rem', color: '#64748b' }}>
                      {person.badgeId || '—'} • {person.designation || 'No designation'}
                    </Typography>
                  </Box>
                  {person.designation && (
                    <Chip
                      label={person.designation}
                      size="small"
                      sx={{ height: 18, fontSize: '0.6rem', ml: 1 }}
                    />
                  )}
                </Box>
              ))}
            </Box>
          ) : (
            <Box sx={{ py: 1.5, px: 2 }}>
              <Typography sx={{ fontSize: '0.8rem', color: '#9ca3af', textAlign: 'center' }}>
                {t('assignDuties.personnel.noPersonnelFound')}
              </Typography>
            </Box>
          )}
        </Paper>
      )}
    </Box>
  );
};

