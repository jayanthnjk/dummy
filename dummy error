Here's how to debug the scheduled email issue on AWS from bash:

1. Check if the scheduler is running
# SSH into your EC2 instance first
ssh -i your-key.pem ec2-user@your-ec2-ip

# Check if the application is running
sudo systemctl status ksp-backend

# Check application logs for scheduler execution
sudo journalctl -u ksp-backend -f --since "today" | grep -i "scheduler\|email\|mail\|form.*168"
2. Check application logs directly
# Find the log file location
cd /path/to/your/app

# Tail the logs looking for scheduler/email related entries
tail -500f logs/application.log | grep -iE "scheduler|email|mail|form.?168|daily.?statement"

# Or search for errors
grep -iE "error|exception|failed" logs/application.log | tail -100
3. Check if the scheduled task is configured
# Look for @Scheduled annotations in your code
grep -r "@Scheduled" --include="*.java" .

# Check cron expression configuration
grep -rE "cron|fixedRate|fixedDelay" --include="*.java" --include="*.properties" --include="*.yml" .
4. Verify email configuration
# Check environment variables for email config
env | grep -iE "mail|smtp|email"

# Check application.properties or application.yml
cat /path/to/app/application.properties | grep -i mail
# or
cat /path/to/app/application.yml | grep -i mail
5. Check AWS SES (if using SES for emails)
# Check SES sending statistics
aws ses get-send-statistics --region your-region

# Check SES identity verification status
aws ses list-identities --region your-region
aws ses get-identity-verification-attributes --identities your-email@domain.com --region your-region

# Check if email is in SES sandbox (only verified emails can receive)
aws ses get-account-sending-enabled --region your-region
6. Test email sending manually
# Use curl to trigger the endpoint manually (if you have one)
curl -X POST http://localhost:8080/api/reports/form-168/email -H "Authorization: Bearer YOUR_TOKEN"

# Or check if there's a test endpoint
curl http://localhost:8080/actuator/health
7. Check CloudWatch logs (if configured)
# List log groups
aws logs describe-log-groups --region your-region

# Get recent logs
aws logs filter-log-events \
  --log-group-name /aws/your-app-log-group \
  --start-time $(date -d '1 hour ago' +%s)000 \
  --filter-pattern "scheduler OR email OR mail" \
  --region your-region
8. Check the scheduled time vs server time
# Check server timezone
timedatectl

# Check current time
date

# Compare with your cron schedule
Quick diagnostic commands
# All-in-one check
echo "=== Service Status ===" && sudo systemctl status ksp-backend | head -20
echo "=== Recent Errors ===" && sudo journalctl -u ksp-backend --since "1 hour ago" | grep -i error | tail -20
echo "=== Scheduler Logs ===" && sudo journalctl -u ksp-backend --since "today" | grep -i schedul | tail -20
echo "=== Email Logs ===" && sudo journalctl -u ksp-backend --since "today" | grep -iE "mail|email|smtp" | tail -20
