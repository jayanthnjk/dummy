  { id: 'A', nameKey: 'assignDuties.sections.sectionA', descKey: 'assignDuties.sections.sectionADesc', color: '#312e81', bgColor: '#eef2ff' },
  { id: 'B', nameKey: 'assignDuties.sections.sectionB', descKey: 'assignDuties.sections.sectionBDesc', color: '#0d9488', bgColor: '#f0fdfa' },
  { id: 'C', nameKey: 'assignDuties.sections.sectionC', descKey: 'assignDuties.sections.sectionCDesc', color: '#7c3aed', bgColor: '#f5f3ff' },
  { id: 'D', nameKey: 'assignDuties.sections.sectionD', descKey: 'assignDuties.sections.sectionDDesc', color: '#dc2626', bgColor: '#fef2f2' },
  { id: 'E', nameKey: 'assignDuties.sections.sectionE', descKey: 'assignDuties.sections.sectionEDesc', color: '#d97706', bgColor: '#fffbeb' },
  { id: 'F', nameKey: 'assignDuties.sections.sectionF', descKey: 'assignDuties.sections.sectionFDesc', color: '#2563eb', bgColor: '#eff6ff' },
  { id: 'G', nameKey: 'assignDuties.sections.sectionG', descKey: 'assignDuties.sections.sectionGDesc', color: '#059669', bgColor: '#ecfdf5' },
